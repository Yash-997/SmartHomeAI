# Copy to .env and change the values. Never commit .env.

# PostgreSQL (docker-compose)
POSTGRES_DB=smarthome
POSTGRES_USER=smarthome
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# MQTT broker (Mosquitto, docker-compose)
MQTT_PORT=1883
# Broker admin account: used by the backend only to create/remove device accounts. Set a strong password.
MQTT_ADMIN_USER=smarthome-admin
MQTT_ADMIN_PASSWORD=change_me_mqtt_admin
# Account the backend uses to receive telemetry (created automatically on first start). Set a strong password.
MQTT_BACKEND_USER=smarthome-backend
MQTT_BACKEND_PASSWORD=change_me_mqtt_backend
# Backend -> broker host (the backend runs on your PC, the broker in Docker)
# MQTT_HOST=localhost
# Set to false to run the API without MQTT (devices can pair but not connect)
# MQTT_ENABLED=true

# Backend (Spring Boot)
# Signing key for JWTs, at least 32 characters. Generate one with:
#   PowerShell: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
#   macOS/Linux: openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_string_of_at_least_32_chars
JWT_EXPIRATION_MINUTES=60
# Comma-separated browser origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Seconds of silence after which a device counts as offline and its readings as stale
# (the firmware should publish about every 30s)
# TELEMETRY_STALE_AFTER_SECONDS=90

# AI assistant. Default: Google Gemini first, Groq as automatic fallback when Gemini is rate limited (429), down (5xx),
# times out or cannot be reached. Bad requests and rejected keys (400/401/403) do not fail over. A provider without an
# API key is skipped; with no key at all the assistant still searches your data and says no language model is configured.
LLM_PROVIDER=gemini
LLM_PRIMARY_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=groq
LLM_TIMEOUT_SECONDS=30
# After a recoverable Gemini failure, go straight to Groq for this many seconds (0 = always try Gemini first)
# LLM_FAILOVER_COOLDOWN_SECONDS=60
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
# Gemini 3 thinking level: minimal, low (default), medium or high
# GEMINI_THINKING_LEVEL=low
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Other providers (set LLM_PROVIDER / LLM_PRIMARY_PROVIDER, and LLM_FALLBACK_PROVIDER=none or groq):
# a local model with Ollama (no key; run `ollama pull <model>` first):
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=<a chat model you pulled>
# OpenAI or any OpenAI-compatible service:
#   LLM_PROVIDER=openai
#   LLM_API_KEY=<your key>
#   LLM_MODEL=<model name>
# Anthropic:
#   LLM_PROVIDER=anthropic
#   LLM_API_KEY=<your key>
#   LLM_MODEL=claude-sonnet-5-5
# Search embeddings: "local" (default) is a built-in word-based embedder. For meaning-based search use a real model:
#   EMBEDDING_PROVIDER=openai
#   EMBEDDING_MODEL=<an embedding model, e.g. nomic-embed-text on Ollama>
#   (EMBEDDING_BASE_URL and EMBEDDING_API_KEY default to the LLM_ ones)

# Gas/smoke email alerts (MQ-2), sent through Gmail SMTP (smtp.gmail.com:587, STARTTLS) to the device owner's account email.
# MAIL_PASSWORD must be a Google App Password (Google Account > Security > 2-Step Verification > App passwords),
# NOT your normal Gmail password. Without MAIL_USERNAME/MAIL_PASSWORD incidents are still recorded, just not mailed.
# Production hosts often block outbound SMTP. Use Brevo's HTTPS API instead (free: 300 emails/day):
#   MAIL_PROVIDER=brevo
#   BREVO_API_KEY=<API key from Brevo > SMTP & API > API Keys>
#   ALERT_MAIL_FROM=<a sender address you verified in Brevo > Senders>   (required with Brevo)
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD=<16-character app password>
# ALERT_MAIL_FROM=            # blank = MAIL_USERNAME (Gmail only sends as the logged-in account)
# ALERT_GAS_THRESHOLD=2500    # raw MQ-2 ADC value (0-4095) at which an incident starts
# ALERT_GAS_RECOVERY_MARGIN_PERCENT=15   # recovery needs readings below threshold minus this percentage
# ALERT_GAS_CONFIRM_READINGS=2           # consecutive readings needed to start / end an incident
# ALERT_GAS_ENABLED=true
# ALERT_MOTION_EMAIL_ENABLED=true          # email the owner once per motion episode while in AWAY mode
# ALERT_DASHBOARD_URL=http://localhost:5174   # address of the web app, used by the buttons in alert emails
# ALERT_ANOMALY_EMAIL_ENABLED=true          # email the owner once per detected anomaly
# ALERT_ANOMALY_EMAIL_MIN_SEVERITY=WARNING  # INFO, WARNING or CRITICAL: lowest severity that is emailed
# ALERT_ANOMALY_EMAIL_COOLDOWN_MINUTES=60   # no second email for the same problem on the same device within this time
# ALERT_TIME_ZONE=Asia/Kolkata            # time zone for times in emails (blank = the server's zone)
# ML_TIME_ZONE=Asia/Kolkata                # local time used to learn daily routines (default Asia/Kolkata)

# Running on a laptop/server for the ESP32 over the local Wi-Fi: keep `docker compose up -d --build` as is.
# Mosquitto listens on 1883 (username/password, no anonymous access); the backend reaches it internally as "mosquitto".
# Set MQTT_HOST in firmware/smarthome_esp32s3/secrets.h to this machine's LAN IP, allow TCP 1883 (and the web port)
# through the Windows firewall, and open the dashboard at http://<LAN-IP>:5174 (add that origin to CORS_ALLOWED_ORIGINS
# and ALERT_DASHBOARD_URL if you use it from other devices).

# Optional: change these if the ports are already used on your machine
# (also set VITE_API_TARGET=http://localhost:<port> when starting the frontend)
# SERVER_PORT=8080
