# Copy to .env and change the values. Never commit .env.

# PostgreSQL (docker-compose)
POSTGRES_DB=smarthome
POSTGRES_USER=smarthome
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# MQTT broker (Mosquitto, docker-compose)
MQTT_PORT=1883
# Broker admin account: used by the backend only to create/remove device accounts. Set a strong password.
MQTT_ADMIN_USER=smarthome-admin
MQTT_ADMIN_PASSWORD=change_me_mqtt_admin
# Account the backend uses to receive telemetry (created automatically on first start). Set a strong password.
MQTT_BACKEND_USER=smarthome-backend
MQTT_BACKEND_PASSWORD=change_me_mqtt_backend
# Backend -> broker host (the backend runs on your PC, the broker in Docker)
# MQTT_HOST=localhost
# Set to false to run the API without MQTT (devices can pair but not connect)
# MQTT_ENABLED=true

# Backend (Spring Boot)
# Signing key for JWTs, at least 32 characters. Generate one with:
#   PowerShell: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
#   macOS/Linux: openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_string_of_at_least_32_chars
JWT_EXPIRATION_MINUTES=60
# Comma-separated browser origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Seconds of silence after which a device counts as offline and its readings as stale
# (the firmware should publish about every 30s)
# TELEMETRY_STALE_AFTER_SECONDS=90

# AI assistant (Chunk 8). All optional: without LLM_PROVIDER the assistant still searches your data and shows the
# matching records, and says that no language model is configured. Keys are only ever sent to the address below.
# Option A, a local model with Ollama (no key; run `ollama pull <model>` first):
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=<a chat model you pulled>
# Option B, OpenAI or any OpenAI-compatible service:
#   LLM_PROVIDER=openai
#   LLM_API_KEY=<your key>
#   LLM_MODEL=<model name>
# Option C, Anthropic:
#   LLM_PROVIDER=anthropic
#   LLM_API_KEY=<your key>
#   LLM_MODEL=claude-sonnet-5-5
#   Groq (OpenAI-compatible; the key is read from GROQ_API_KEY):
#   LLM_PROVIDER=groq
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=llama-3.3-70b-versatile
#   GROQ_API_KEY=<your key>
# LLM_TIMEOUT_SECONDS=30
# Search embeddings: "local" (default) is a built-in word-based embedder. For meaning-based search use a real model:
#   EMBEDDING_PROVIDER=openai
#   EMBEDDING_MODEL=<an embedding model, e.g. nomic-embed-text on Ollama>
#   (EMBEDDING_BASE_URL and EMBEDDING_API_KEY default to the LLM_ ones)

# Gas/smoke email alerts (MQ-2), sent through Gmail SMTP (smtp.gmail.com:587, STARTTLS) to the device owner's account email.
# MAIL_PASSWORD must be a Google App Password (Google Account > Security > 2-Step Verification > App passwords),
# NOT your normal Gmail password. Without MAIL_USERNAME/MAIL_PASSWORD incidents are still recorded, just not mailed.
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD=<16-character app password>
# ALERT_MAIL_FROM=            # blank = MAIL_USERNAME (Gmail only sends as the logged-in account)
# ALERT_GAS_THRESHOLD=2500    # raw MQ-2 ADC value (0-4095) at which an incident starts
# ALERT_GAS_RECOVERY_MARGIN_PERCENT=15   # recovery needs readings below threshold minus this percentage
# ALERT_GAS_CONFIRM_READINGS=2           # consecutive readings needed to start / end an incident
# ALERT_GAS_ENABLED=true

# Optional: change these if the ports are already used on your machine
# (also set VITE_API_TARGET=http://localhost:<port> when starting the frontend)
# SERVER_PORT=8080
